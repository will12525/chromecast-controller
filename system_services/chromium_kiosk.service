[Unit]
Description=Chromium kiosk for the local media client

[Service]
Type=simple
TimeoutStartSec=120
ExecStartPre=/bin/bash -c 'for _ in $(seq 1 90); do { echo >/dev/tcp/127.0.0.1/5000; } 2>/dev/null && exit 0; sleep 1; done; echo "flask did not open port 5000" >&2; exit 1'
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --check-for-update-interval=31536000 http://127.0.0.1:5000
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
